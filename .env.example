# Google Apps Script URL para log de acessos no Google Sheets
# Obtenha em: Extensões → Apps Script → Implantar → App da Web
GOOGLE_APPS_SCRIPT_URL=https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec

